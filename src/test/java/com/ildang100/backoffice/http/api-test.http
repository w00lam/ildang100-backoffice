@baseUrl = http://localhost:8080
@superAdminEmail = admin@sparta.com
@superAdminPassword = sparta1234
@operationAdminEmail = operation@sparta.com
@operationAdminPassword = password123
@csAdminEmail = cs@sparta.com
@csAdminPassword = password123

@adminId = 1
@targetAdminId = 3
@pendingAdminId = 13
@customerId = 1
@targetCustomerId = 2
@productId = 1
@targetProductId = 2
@reviewProductId = 1
@reviewId = 1
@orderId = 1

### 인증 - 관리자 회원가입 성공
POST {{baseUrl}}/admins/signup
Content-Type: application/json

{
  "name": "테스트관리자",
  "email": "api-test-{{$timestamp}}@example.com",
  "password": "P@ssw0rd!",
  "tele": "010-9000-0001",
  "role": "OPERATIONS_ADMIN"
}

### 인증 - 관리자 회원가입 실패: 이메일 중복
POST {{baseUrl}}/admins/signup
Content-Type: application/json

{
  "name": "중복관리자",
  "email": "{{superAdminEmail}}",
  "password": "P@ssw0rd!",
  "tele": "010-9000-0002",
  "role": "OPERATIONS_ADMIN"
}

### 인증 - 관리자 로그인 성공: accessToken 저장
POST {{baseUrl}}/admins/login
Content-Type: application/json

{
  "email": "{{superAdminEmail}}",
  "password": "{{superAdminPassword}}"
}

> {%
if (response.body && response.body.data && response.body.data.accessToken) {
  client.global.set("accessToken", response.body.data.accessToken);
}
%}

### 인증 - 관리자 로그인 실패: 비밀번호 불일치
POST {{baseUrl}}/admins/login
Content-Type: application/json

{
  "email": "{{superAdminEmail}}",
  "password": "wrong-password"
}

### 인증 - 관리자 로그아웃 성공
POST {{baseUrl}}/admins/logout
Authorization: Bearer {{accessToken}}

### 인증 - 관리자 로그아웃 실패: 토큰 누락
# 인증 실패 확인용 요청입니다. 이 요청만 Authorization 헤더를 의도적으로 제외합니다.
POST {{baseUrl}}/admins/logout

### 관리자 - 목록 조회 성공
GET {{baseUrl}}/admins?page=1&size=10&sortBy=createdAt&sortOrder=desc
Authorization: Bearer {{accessToken}}

### 관리자 - 목록 조회 실패: 잘못된 role 쿼리
GET {{baseUrl}}/admins?role=INVALID_ROLE
Authorization: Bearer {{accessToken}}

### 관리자 - 상세 조회 성공
GET {{baseUrl}}/admins/{{adminId}}
Authorization: Bearer {{accessToken}}

### 관리자 - 상세 조회 실패: 존재하지 않는 관리자
GET {{baseUrl}}/admins/999999
Authorization: Bearer {{accessToken}}

### 관리자 - 정보 수정 성공
PUT {{baseUrl}}/admins/{{targetAdminId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "수정관리자",
  "tele": "010-3333-3333"
}

### 관리자 - 정보 수정 실패: 전화번호 형식 오류
PUT {{baseUrl}}/admins/{{targetAdminId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tele": "010-123-4567"
}

### 관리자 - 역할 변경 성공
PUT {{baseUrl}}/admins/{{targetAdminId}}/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "role": "CS_ADMIN"
}

### 관리자 - 역할 변경 실패: 잘못된 role 값
PUT {{baseUrl}}/admins/{{targetAdminId}}/role
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "role": "INVALID_ROLE"
}

### 관리자 - 상태 변경 성공
PUT {{baseUrl}}/admins/4/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "INACTIVE"
}

### 관리자 - 상태 변경 실패: 잘못된 status 값
PUT {{baseUrl}}/admins/4/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "INVALID_STATUS"
}

### 관리자 - 삭제 성공
DELETE {{baseUrl}}/admins/10
Authorization: Bearer {{accessToken}}

### 관리자 - 삭제 실패: 슈퍼 관리자 삭제 불가
DELETE {{baseUrl}}/admins/1
Authorization: Bearer {{accessToken}}

### 관리자 - 가입 승인 성공
PATCH {{baseUrl}}/admins/{{pendingAdminId}}/approval
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isApproved": true,
  "rejectReason": null
}

### 관리자 - 가입 승인 실패: 이미 처리된 관리자
PATCH {{baseUrl}}/admins/{{adminId}}/approval
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isApproved": true,
  "rejectReason": null
}

### 내 프로필 - 조회 성공
GET {{baseUrl}}/admins/me
Authorization: Bearer {{accessToken}}

### 내 프로필 - 조회 실패: 토큰 누락
# 인증 실패 확인용 요청입니다. 이 요청만 Authorization 헤더를 의도적으로 제외합니다.
GET {{baseUrl}}/admins/me

### 내 프로필 - 수정 성공
PUT {{baseUrl}}/admins/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "admin",
  "tele": "010-0000-0000"
}

### 내 프로필 - 수정 실패: 이메일 형식 오류
PUT {{baseUrl}}/admins/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "invalid-email"
}

### 내 프로필 - 비밀번호 변경 성공
# 같은 비밀번호로 재설정해 반복 실행 시 로그인 비밀번호가 바뀌지 않게 합니다.
PATCH {{baseUrl}}/admins/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{superAdminPassword}}",
  "newPassword": "{{superAdminPassword}}",
  "newPasswordConfirm": "{{superAdminPassword}}"
}

### 내 프로필 - 비밀번호 변경 실패: 새 비밀번호 확인 불일치
PATCH {{baseUrl}}/admins/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{superAdminPassword}}",
  "newPassword": "NewP@ssw0rd!",
  "newPasswordConfirm": "MismatchP@ssw0rd!"
}

